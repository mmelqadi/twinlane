# reason: public GitHub private-advisory reporting URL in SECURITY.md (a URL path, not a secret).
^SECURITY\.md:high-entropy:com/
# reason: long descriptive unittest method names (test_...) score as high entropy.
^tests/test_[a-z_]+\.py:high-entropy:test
# reason: obviously fake keys, tokens, base64 runs and paths used as inputs to the redaction tests (e.g. the AWS documentation example key).
^tests/test_(board|baton|meter|sessions)\.py:(anthropic-key|jwt|url-credentials|generic-secret-assignment|high-entropy):
# reason: Windows API function names (ConvertStringSecurityDescriptor...) in the file ACL helper.
^twinlane/envhandoff\.py:high-entropy:Conv
# reason: token-usage accounting names (input_tokens, total_tokens), not credentials.
^twinlane/(jobs|codex_runner|baton)\.py:generic-secret-assignment:
# reason: a synthetic Claude transcript fixture and fake env values in the job tests (no real credentials).
^tests/(fixtures/claude_transcript\.jsonl|test_jobs\.py):generic-secret-assignment:
# reason: a Windows path written with \x escapes in a guard test (the alice placeholder user), not a secret.
^tests/test_guard\.py:high-entropy:x2fU
# reason: a long descriptive test helper name (_check_...) scores as high entropy.
^tests/test_jobs\.py:high-entropy:_check_[a-z_]+$
# reason: regex/frozenset definitions whose NAMES contain TOKEN or SECRET (CMD_TOKEN, SECRET_ENV_NAME, SECRET_ENV_KEEP), not secret values.
^twinlane/(common|guard)[.]py:generic-secret-assign(?:)ment:(?:re[.]compile[(]r?|frozenset[(]?[)]?)$
# reason: slash-joined git subcommand and GIT_* variable lists in guard docs and messages score as high entropy.
^twinlane/guard[.]py:high-entropy:(?:commit/push/[a-z/-]+|GIT_[A-Z_]+(?:/GIT_[A-Z_]+)+)$
# reason: The README CI badge links this repository's own public Actions workflow page.
^(?:history@99a588e:)?README\.md:high-entropy:c[o]m/mmelqadi/twinlane/act(?:)ions/workflows/ci$
# reason: SHA-256 digests of fixed public fixture strings (a task id and dispatch fingerprints) pinned in the predecessor-registry replay tests; they are content hashes, not credentials.
^tests/test_coordination\.py:high-entropy:(?:c2ad|89e7|a5ca|0d15)[0-9a-f]{60}$
# reason: a random holder id for the land lock record (uuid4 hex), a lock identity and not a credential.
^twinlane/land\.py:generic-secret-assign(?:)ment:uuid[.]uuid4[(][)][.]hex$
# reason: long descriptive unittest helper names (_check_...) score as high entropy, not credentials.
^tests/test_jobs\.py:high-entropy:_che
# reason: variable and constant names containing 'token' (command tokens, regex token tables, token counts, contextvar reset tokens), not credentials.
^twinlane/(common|guard|projects|land|ship|context|observations)\.py:generic-secret-assignment:
# reason: documentation and docstrings listing GIT_* environment variable names, git subcommand lists and a Windows install path, not credentials.
^twinlane/(common|guard)\.py:high-entropy:(comm|GIT_|LOCA)
# reason: the README CI badge links to this repository's own public workflow.
^README\.md:high-entropy:com/
# reason: SHA-256 digests used as fake fingerprints and registry names in the coordination tests.
^tests/test_coordination\.py:high-entropy:
# reason: a prose list of file paths in a design note, not a credential.
^METADATA-PRESERVING-START\.md:high-entropy:obse
# reason: synthetic usage fixtures with token-count fields (input_tokens), not credentials.
^tests/(fixtures/claude_transcript_usage\.jsonl|test_p0b\.py):generic-secret-assignment:
# reason: slash-separated lists of verbs and tool names in older commit messages score as high entropy.
^<commit-message>:high-entropy:(regi|queu|comp|into|more)
